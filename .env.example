# ClauseLens Configuration
HOST=127.0.0.1
PORT=5000
DEBUG=false
SECRET_KEY=change-me-in-production-random-secret
DATABASE_PATH=clauselens.db
MAX_UPLOAD_MB=15
RETENTION_DAYS=30
SCANNED_THRESHOLD=100

# Nemotron P2 Optional Integration (Disabled by default)
NEMOTRON_ENABLED=false
NEMOTRON_BASE_URL=http://localhost:8000/v1
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct
NEMOTRON_TIMEOUT=20
